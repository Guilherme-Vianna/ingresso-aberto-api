    "prisma:migrate": "prisma migrate dev",
    "migrate": "prisma migrate deploy",
    "start": "pnpm run migrate && node --enable-source-maps dist/main.js",
    "dev": "pnpm run migrate && pnpm run build && pnpm run \"/^watch:/\"",
